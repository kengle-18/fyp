# Scala source files
*.scala    text eol=lf
*.sbt      text eol=lf

# Configuration files
*.conf     text eol=lf
*.properties text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Shell scripts and Docker
*.sh       text eol=lf
Dockerfile text eol=lf

# Ignore line ending conversions for binaries
*.jar      binary
*.png      binary
*.jpg      binary
*.ico      binary
*.dll      binary
*.exe      binary

# Generated protobuf files (ScalaPB)
*.proto    text eol=lf
*.pb.scala text eol=lf
